// The app's own controls, in its visual language (see theme.slint). Slint's standard widgets have
// their own look, so only plain elements are used here. Things you press are round: pills, and
// circles for icon buttons. Controls that belong together touch: a long row is one pill split by
// walls (Films), a short group is beads joined by necks (Btn's `bead`). Menus grow out of what
// opened them (Bud), tips hang from the pointer (TipBox), a drag is tied to where it started
// (Tether) and lands in a dashed Place, and empty space is a Lattice of dots.

import { Theme } from "theme.slint";

/// Drawn icons for Btn's `shape`, in a 16 x 16 box. Characters like ▶, ⏏ and ↩ come out as color
/// emoji on Windows, so the app draws its own.
export global Icon {
    out property <string> play: "M 4 2 L 14 8 L 4 14 Z";
    out property <string> pause: "M 3 2 L 6.5 2 L 6.5 14 L 3 14 Z M 9.5 2 L 13 2 L 13 14 L 9.5 14 Z";
    out property <string> previous: "M 2 2 L 4 2 L 4 14 L 2 14 Z M 14 2 L 14 14 L 5 8 Z";
    out property <string> next: "M 12 2 L 14 2 L 14 14 L 12 14 Z M 2 2 L 11 8 L 2 14 Z";
    out property <string> back: "M 7 2 L 2 6 L 7 10 L 7 7 L 10 7 A 2.5 2.5 0 0 1 10 12 L 6 12 L 6 14 L 10 14 A 4.5 4.5 0 0 0 10 5 L 7 5 Z";
    out property <string> eject: "M 8 2 L 14 9 L 2 9 Z M 2 11 L 14 11 L 14 14 L 2 14 Z";
    out property <string> note: "M 2 12 A 3 2.3 0 1 0 8 12 A 3 2.3 0 1 0 2 12 Z M 7 11 L 8.3 11 L 8.3 2 L 7 2 Z M 8.3 2 C 9 5 13 5.5 12 9.5 C 11.5 7 10 6.3 8.3 6 Z";
}

/// A Btn's place in a Films strip.
export enum Join { none, first, middle, last }

/// The window's size, set by the app, so a Bud near the bottom opens upward and a tip near the
/// right edge hangs to the left.
export global Screen {
    in-out property <length> width: 100000px;
    in-out property <length> height: 100000px;
}

/// Tooltip body in the app's style: a note hanging from the pointer on a short leader. Slint puts
/// a tooltip just under the pointer, inside the style's own frame, which can't be turned off. So
/// this takes no room, which shrinks that frame to its empty padding, and covers it.
export component TipBox inherits Rectangle {
    in property <string> text;
    /// Window x of what it's about. Inside the tooltip's popup positions start from the popup,
    /// so the owner says where it is, and the tip hangs to the left near the window's edge.
    in property <length> from-x;
    property <bool> left: root.from-x + box.width > Screen.width;
    width: 0px;
    height: 0px;
    Rectangle {
        width: 18px;
        height: 12px;
        background: Theme.bg;
    }
    Rectangle {
        x: 2px;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: Theme.accent;
    }
    Rectangle {
        x: 4px;
        y: 2px;
        width: 1px;
        height: 12px;
        background: Theme.accent;
    }
    box := Rectangle {
        x: root.left ? 15px - self.width : -6px;
        y: 14px;
        width: label.preferred-width + 20px;
        height: label.preferred-height + 8px;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.accent;
        border-radius: Theme.round-pop;
        label := Text {
            x: 10px;
            y: 4px;
            text: root.text;
            color: Theme.text;
            font-size: Theme.fs-additional;
        }
    }
}

/// A popup's body that grows out of what opened it through a neck. Put it in a PopupWindow whose
/// top edge sits 1px above the anchor's bottom edge (with `up`, whose bottom edge sits 1px below
/// the anchor's top), and give it the anchor's middle as `neck-x`. A menu opened at the pointer
/// has nothing to grow from: `neck: false`.
export component Bud inherits Rectangle {
    in property <length> neck-x: 24px;
    in property <bool> neck: true;
    in property <bool> up;
    in property <length> inset: 12px;
    in property <length> spacing: 8px;
    VerticalLayout {
        // Room for the neck on both sides, so the height doesn't depend on which way it opens.
        padding-top: root.neck ? 9px : 0px;
        padding-bottom: root.neck ? 9px : 0px;
        Rectangle {
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.accent;
            border-radius: Theme.round-pop;
            clip: true;
            VerticalLayout {
                padding: root.inset;
                spacing: root.spacing;
                @children
            }
        }
    }
    // Narrower where it leaves the anchor than where it opens into the body. The ground fill
    // hides both outlines where they meet, then the two edges are drawn.
    if root.neck: Path {
        x: root.neck-x - 14px;
        y: root.up ? root.height - 10px : 0px;
        width: 28px;
        height: 10px;
        viewbox-width: 28;
        viewbox-height: 10;
        fit: fill;
        fill: Theme.bg;
        commands: root.up ? "M 4 10 L 24 10 L 24 9.5 C 18 9.5 18 0.5 28 0.5 L 28 0 L 0 0 L 0 0.5 C 10 0.5 10 9.5 4 9.5 Z" : "M 4 0 L 24 0 L 24 0.5 C 18 0.5 18 9.5 28 9.5 L 28 10 L 0 10 L 0 9.5 C 10 9.5 10 0.5 4 0.5 Z";
    }
    if root.neck: Path {
        x: root.neck-x - 14px;
        y: root.up ? root.height - 10px : 0px;
        width: 28px;
        height: 10px;
        viewbox-width: 28;
        viewbox-height: 10;
        fit: fill;
        stroke: Theme.accent;
        stroke-width: 1px;
        commands: root.up ? "M 4 9.5 C 10 9.5 10 0.5 0 0.5 M 24 9.5 C 18 9.5 18 0.5 28 0.5" : "M 4 0.5 C 10 0.5 10 9.5 0 9.5 M 24 0.5 C 18 0.5 18 9.5 28 9.5";
    }
}

/// A 1px dashed outline. Slint has no dashed strokes, so straight runs are short rectangles. The
/// corners within `radius` stay open, except on a pill (or circle), whose round ends are dashed
/// arcs.
export component Dashed inherits Rectangle {
    in property <color> stroke;
    in property <length> radius;
    property <length> r: Math.min(root.radius, root.height / 2, root.width / 2);
    property <bool> pill: root.r > 0px && root.r * 2 >= root.height;
    property <length> run-x: root.width - 2 * root.r;
    property <length> run-y: root.height - 2 * root.r;
    property <int> nx: root.run-x <= 0px ? 0 : Math.max(1, Math.floor(root.run-x / 7px));
    property <int> ny: root.run-y <= 0px ? 0 : Math.max(1, Math.floor(root.run-y / 7px));
    for i in root.nx: Rectangle {
        x: root.r + i * 7px;
        y: 0px;
        width: Math.min(4px, root.r + root.run-x - self.x);
        height: 1px;
        background: root.stroke;
    }
    for i in root.nx: Rectangle {
        x: root.r + i * 7px;
        y: root.height - 1px;
        width: Math.min(4px, root.r + root.run-x - self.x);
        height: 1px;
        background: root.stroke;
    }
    for i in root.ny: Rectangle {
        x: 0px;
        y: root.r + i * 7px;
        width: 1px;
        height: Math.min(4px, root.r + root.run-y - self.y);
        background: root.stroke;
    }
    for i in root.ny: Rectangle {
        x: root.width - 1px;
        y: root.r + i * 7px;
        width: 1px;
        height: Math.min(4px, root.r + root.run-y - self.y);
        background: root.stroke;
    }
    // Five dashes on each half circle, in a 50 x 100 box that's stretched to the end's size.
    if root.pill: Path {
        x: 0px;
        width: root.r;
        height: root.height;
        viewbox-width: 50;
        viewbox-height: 100;
        fit: fill;
        commands: "M 42.26 1.11 A 49.5 49.5 0 0 0 27.53 5.9 M 15 15 A 49.5 49.5 0 0 0 5.9 27.53 M 1.11 42.26 A 49.5 49.5 0 0 0 1.11 57.74 M 5.9 72.47 A 49.5 49.5 0 0 0 15 85 M 27.53 94.1 A 49.5 49.5 0 0 0 42.26 98.89";
        stroke: root.stroke;
        stroke-width: 1px;
    }
    if root.pill: Path {
        x: root.width - root.r;
        width: root.r;
        height: root.height;
        viewbox-width: 50;
        viewbox-height: 100;
        fit: fill;
        commands: "M 7.74 1.11 A 49.5 49.5 0 0 1 22.47 5.9 M 35 15 A 49.5 49.5 0 0 1 44.1 27.53 M 48.89 42.26 A 49.5 49.5 0 0 1 48.89 57.74 M 44.1 72.47 A 49.5 49.5 0 0 1 35 85 M 22.47 94.1 A 49.5 49.5 0 0 1 7.74 98.89";
        stroke: root.stroke;
        stroke-width: 1px;
    }
}

/// Squashes while held down and springs back when let go. Inside a Films strip only the height
/// moves, so the walls stay where they are.
component Squashy inherits Rectangle {
    in-out property <bool> squashed;
    in property <bool> keep-width;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-scale-x: root.squashed && !root.keep-width ? 1.06 : 1;
    transform-scale-y: root.squashed ? 0.84 : 1;
    animate transform-scale-x, transform-scale-y {
        duration: root.squashed ? 70ms : 550ms;
        easing: root.squashed ? ease-out : ease-out-elastic;
    }
}

/// The small concave web where a wall meets the outline, like the border where soap films meet.
component Fillet inherits Path {
    /// Which side of the wall, and which end.
    in property <bool> left;
    in property <bool> top;
    width: 4px;
    height: 4px;
    viewbox-width: 4;
    viewbox-height: 4;
    fill: Theme.line;
    commands: root.top ? (root.left ? "M 0 0 A 4 4 0 0 1 4 4 L 4 0 Z" : "M 4 0 A 4 4 0 0 0 0 4 L 0 0 Z") : (root.left ? "M 0 4 A 4 4 0 0 0 4 0 L 4 4 Z" : "M 4 4 A 4 4 0 0 1 0 0 L 0 4 Z");
}

/// The wall between two cells of a Films strip, with a fillet on each side where it meets the
/// outline.
export component Wall inherits Rectangle {
    width: 1px;
    background: Theme.line;
    Fillet { x: -4px; y: 1px; left: true; top: true; }
    Fillet { x: 1px; y: 1px; top: true; }
    Fillet { x: -4px; y: parent.height - 5px; left: true; }
    Fillet { x: 1px; y: parent.height - 5px; }
}

/// Controls that act on the same thing, as one pill split by walls: put a Wall between cells and
/// give each Btn its `join`. For long rows; a group of two or three uses beads instead.
export component Films inherits Rectangle {
    border-radius: self.height / 2;
    HorizontalLayout {
        @children
    }
    Rectangle {
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: Theme.accent;
    }
}

/// Keyboard focus for a control. Off unless `on`, and never taken by a click, so an app's own key
/// handling (Albumka's Tab through tracks) keeps working. Enter and Space activate; with `arrows`,
/// the arrow keys step. Two corner marks show where the focus is.
component KeyFocus inherits FocusScope {
    in property <bool> on;
    in property <bool> arrows;
    callback activated();
    callback stepped(int);
    enabled: root.on;
    focus-on-click: false;
    key-pressed(e) => {
        if e.text == Key.Return || e.text == " " {
            root.activated();
            return accept;
        }
        if root.arrows && (e.text == Key.RightArrow || e.text == Key.UpArrow) {
            root.stepped(1);
            return accept;
        }
        if root.arrows && (e.text == Key.LeftArrow || e.text == Key.DownArrow) {
            root.stepped(-1);
            return accept;
        }
        reject
    }
    if root.has-focus: Rectangle {
        Rectangle { x: -4px; y: -4px; width: 8px; height: 2px; background: Theme.accent; }
        Rectangle { x: -4px; y: -4px; width: 2px; height: 8px; background: Theme.accent; }
        Rectangle { x: parent.width - 4px; y: parent.height + 2px; width: 8px; height: 2px; background: Theme.accent; }
        Rectangle { x: parent.width + 2px; y: parent.height - 4px; width: 2px; height: 8px; background: Theme.accent; }
    }
}

export component Btn inherits Squashy {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> danger;
    /// Compact, fixed height: glyphs that fall back to another font would otherwise size it differently.
    in property <bool> icon;
    in property <string> tip;
    /// A typeface other than the app's, to show it.
    in property <string> family;
    /// Reachable with Tab (see KeyFocus).
    in property <bool> tab-stop;
    /// Its place in a Films strip; `none` is a pill of its own.
    in property <Join> join: Join.none;
    /// Joined by a neck to the pill before it, which sits `Theme.bead-gap` to the left.
    in property <bool> bead;
    /// One of `Icon`'s shapes, drawn instead of the text.
    in property <string> shape;
    callback clicked();

    accessible-role: button;
    // An icon's glyph (× or …) says little out loud; its tip says what it does.
    accessible-label: root.icon && root.tip != "" ? root.tip : root.text;
    accessible-description: root.icon ? "" : root.tip;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    property <color> fg: root.danger ? Theme.danger : Theme.accent;
    property <bool> hot: touch.has-hover && root.enabled;
    squashed: touch.pressed && root.enabled;
    keep-width: root.join != Join.none;
    min-height: root.icon ? 30px : 0px;
    min-width: root.icon ? 30px : 0px;
    // Round at the ends it doesn't share with a neighbour.
    property <length> cap-left: root.join == Join.none || root.join == Join.first ? root.height / 2 : 0px;
    property <length> cap-right: root.join == Join.none || root.join == Join.last ? root.height / 2 : 0px;
    border-top-left-radius: root.cap-left;
    border-bottom-left-radius: root.cap-left;
    border-top-right-radius: root.cap-right;
    border-bottom-right-radius: root.cap-right;
    background: root.hot ? Theme.hover-wash : root.join == Join.none ? Theme.bg : transparent;
    border-width: root.join == Join.none ? 1px : 0px;
    // A pulse while hovered, on the colors: pulsing the opacity would draw the button through a
    // layer, where the GPU renderer places the text a pixel or two off. It starts on the beat the
    // pointer arrives and stops after two, so a resting pointer doesn't keep the window redrawing.
    property <duration> hover-start;
    property <bool> pulsing;
    changed hot => {
        root.hover-start = animation-tick();
        root.pulsing = root.hot;
    }
    Timer {
        interval: 2s;
        running: root.pulsing;
        triggered => { root.pulsing = false; }
    }
    property <float> pulse: root.pulsing ? 0.875 + 0.125 * Math.cos((animation-tick() - root.hover-start) / 1s * 360deg) : 1;
    border-color: root.fg.with-alpha(root.pulse);
    opacity: root.enabled ? 1 : 0.3;
    animate background { duration: 300ms; }

    // The neck to the bead on the left: a waist between the two round ends, from the same curve
    // as two drops of water about to touch. Filled with the ground first, so the two outlines
    // open into each other, then the waist's two edges are drawn.
    if root.bead: Rectangle {
        property <float> r: root.height / 2px;
        property <float> g: Theme.bead-gap / 1px;
        property <float> k: self.r * 0.7071;
        property <float> c: -self.g - self.r;
        property <float> h: self.r * Math.min(1.2, (self.g + 2 * self.r - 2 * self.k) / (2 * self.r)) * 0.7071;
        property <string> lower: "M \{self.c + self.k} \{self.r + self.k} C \{self.c + self.k + self.h} \{self.r + self.k - self.h} \{self.r - self.k - self.h} \{self.r + self.k - self.h} \{self.r - self.k} \{self.r + self.k}";
        property <string> upper: "\{self.r - self.k} \{self.r - self.k} C \{self.r - self.k - self.h} \{self.r - self.k + self.h} \{self.c + self.k + self.h} \{self.r - self.k + self.h} \{self.c + self.k} \{self.r - self.k}";
        Path {
            x: (parent.c - parent.r) * 1px;
            width: (parent.g + 3 * parent.r) * 1px;
            height: root.height;
            viewbox-x: parent.c - parent.r;
            viewbox-width: parent.g + 3 * parent.r;
            viewbox-height: 2 * parent.r;
            fit: fill;
            commands: parent.lower + " L " + parent.upper + " Z";
            fill: Theme.bg;
        }
        Path {
            x: (parent.c - parent.r) * 1px;
            width: (parent.g + 3 * parent.r) * 1px;
            height: root.height;
            viewbox-x: parent.c - parent.r;
            viewbox-width: parent.g + 3 * parent.r;
            viewbox-height: 2 * parent.r;
            fit: fill;
            commands: parent.lower + " M " + parent.upper;
            stroke: root.fg;
            stroke-width: 1px;
        }
    }

    HorizontalLayout {
        padding-left: root.icon ? 7px : 14px;
        padding-right: root.icon ? 7px : 14px;
        padding-top: root.icon ? 0px : 5px;
        padding-bottom: root.icon ? 0px : 5px;
        Text {
            text: root.shape == "" ? root.text : "";
            color: (root.hot && !root.danger ? Theme.text : root.fg).with-alpha(root.pulse);
            font-family: root.family;
            font-size: Theme.fs-main;
            font-weight: root.primary ? 700 : 400;
            letter-spacing: root.icon ? 0px : 1px;
            // A label is never cut; a row of beads that can't fit has to wrap instead.
            min-width: self.preferred-width;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    if root.shape != "": Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: 12px;
        height: 12px;
        viewbox-width: 16;
        viewbox-height: 16;
        fit: fill;
        fill: (root.hot && !root.danger ? Theme.text : root.fg).with-alpha(root.pulse);
        commands: root.shape;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    KeyFocus {
        on: root.tab-stop && root.enabled;
        activated => { root.clicked(); }
    }

    if root.tip != "": Tooltip {
        TipBox {
            text: root.tip;
            from-x: root.absolute-position.x;
        }
    }
}

/// ⌜text⌟, with the corners drawn as lines: monospace fonts lack those glyphs, and Slint's font
/// fallback doesn't always find them.
export component Bracketed inherits HorizontalLayout {
    in property <string> text;
    in property <color> color: Theme.accent;
    in property <length> font-size: Theme.fs-head;
    in property <int> font-weight: 400;
    /// The corners mean "current"; without them the text keeps its place.
    in property <bool> marks: true;
    spacing: 5px;
    Rectangle {
        width: 7px;
        visible: root.marks;
        Rectangle {
            y: parent.height * 0.2;
            height: 1px;
            background: root.color;
        }
        Rectangle {
            x: 0px;
            y: parent.height * 0.2;
            width: 1px;
            height: 7px;
            background: root.color;
        }
    }
    Text {
        text: root.text;
        color: root.color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: 3px;
        vertical-alignment: center;
    }
    Rectangle {
        width: 7px;
        visible: root.marks;
        Rectangle {
            y: parent.height * 0.8 - 1px;
            height: 1px;
            background: root.color;
        }
        Rectangle {
            x: parent.width - 1px;
            y: parent.height * 0.8 - 7px;
            width: 1px;
            height: 7px;
            background: root.color;
        }
    }
}

/// Header tab: the inactive view is dimmed and loses its corners.
export component TabBtn inherits Squashy {
    in property <string> text;
    in property <bool> active;
    /// Reachable with Tab (see KeyFocus).
    in property <bool> tab-stop;
    callback clicked();
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }
    horizontal-stretch: 0;
    squashed: touch.pressed;
    HorizontalLayout {
        padding-right: 14px;
        alignment: start;
        Bracketed {
            text: root.text;
            color: root.active ? Theme.accent : Theme.accent-dim;
            marks: root.active;
            font-size: Theme.fs-head-lg;
            font-weight: 700;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    KeyFocus {
        on: root.tab-stop;
        activated => { root.clicked(); }
    }
}

/// One-line text field, a pill. Dashed while empty ("you can type here"), solid once filled.
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> small;
    /// No frame unless `show-frame` (a hovered row) or focused: for track titles.
    in property <bool> ghost;
    in property <bool> show-frame: !root.ghost;
    /// The cosmetic ":::" in front, like a prompt; never part of the text.
    in property <bool> prefix: true;
    in property <bool> read-only;
    in property <bool> enabled: true;
    in property <TextHorizontalAlignment> align: left;
    in property <length> font-size: Theme.fs-secondary;
    in property <int> font-weight: 400;
    in property <color> fg: Theme.text;
    /// For fields on a tag's color: a fixed frame instead of the accent.
    in property <color> frame-color: transparent;
    in property <string> tip;
    /// What a screen reader calls the field (the label shown above it isn't linked); else the placeholder.
    in property <string> label;
    out property <bool> focused: input.has-focus;
    callback edited(string);
    callback accepted(string);
    /// On enter or when focus leaves: for fields that apply only when done.
    callback committed(string);


    property <bool> filled: root.text != "";
    property <bool> framed: root.show-frame || root.focused;
    property <color> frame: root.frame-color != transparent ? root.frame-color : root.focused ? Theme.accent : Theme.line;
    opacity: root.enabled ? 1 : 0.4;
    border-radius: self.height / 2;
    border-width: root.framed && root.filled ? 1px : 0px;
    border-color: root.frame;

    if root.framed && !root.filled: Dashed {
        radius: root.height / 2;
        stroke: root.focused && root.frame-color == transparent ? Theme.accent : root.frame;
    }

    // Behind the input: a click on the frame, prefix or padding focuses it, while clicks on the
    // input itself keep their caret and selection.
    TouchArea {
        enabled: root.enabled && !root.read-only;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: root.small ? 10px : 12px;
        padding-right: root.small ? 10px : 12px;
        padding-top: root.small ? 3px : 5px;
        padding-bottom: root.small ? 3px : 5px;
        spacing: 6px;
        if root.prefix: Text {
            text: ":::";
            color: Theme.muted;
            font-size: root.font-size;
            vertical-alignment: center;
            accessible-role: none;
        }
        Rectangle {
            horizontal-stretch: 1;
            min-width: 8px;
            min-height: input.preferred-height;
            // Long text stays inside the field (it scrolls while typing) instead of running past it.
            clip: true;
            input := TextInput {
                y: (parent.height - self.height) / 2;
                width: parent.width;
                text <=> root.text;
                single-line: true;
                read-only: root.read-only || !root.enabled;
                enabled: root.enabled;
                color: root.fg;
                font-size: root.font-size;
                font-weight: root.font-weight;
                horizontal-alignment: root.align;
                selection-background-color: Theme.line;
                selection-foreground-color: Theme.text;
                accessible-label: root.label != "" ? root.label : root.placeholder;
                accessible-placeholder-text: root.placeholder;
                accessible-description: root.tip;
                edited => { root.edited(self.text); }
                accepted => {
                    root.accepted(self.text);
                    root.committed(self.text);
                }
                changed has-focus => {
                    if !self.has-focus {
                        root.committed(self.text);
                    }
                }
            }
            if root.text == "": Text {
                width: parent.width;
                text: root.placeholder;
                color: Theme.muted;
                font-size: Theme.fs-additional;
                vertical-alignment: center;
                horizontal-alignment: root.align;
                overflow: elide;
                accessible-role: none;
            }
        }
    }

    if root.tip != "": Tooltip {
        TipBox {
            text: root.tip;
            from-x: root.absolute-position.x;
        }
    }
}

/// Multi-line text, scrolling when it outgrows the box.
export component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <bool> read-only;
    /// What a screen reader calls it.
    in property <string> label;
    callback edited(string);

    property <bool> filled: root.text != "";
    border-radius: Theme.round-pop;
    border-width: root.filled || input.has-focus ? 1px : 0px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    if !root.filled && !input.has-focus: Dashed {
        radius: Theme.round-pop;
        stroke: Theme.line;
    }

    TouchArea {
        enabled: !root.read-only;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    Text {
        x: 12px;
        y: 7px;
        text: ":::";
        color: Theme.muted;
        font-size: Theme.fs-secondary;
        accessible-role: none;
    }

    flick := Flickable {
        x: 44px;
        y: 7px;
        width: parent.width - 56px;
        height: parent.height - 14px;
        content-height: Math.max(self.height, input.preferred-height);
        input := TextInput {
            width: parent.width;
            height: Math.max(flick.height, self.preferred-height);
            text <=> root.text;
            single-line: false;
            wrap: word-wrap;
            read-only: root.read-only;
            color: Theme.text;
            font-size: Theme.fs-secondary;
            selection-background-color: Theme.line;
            selection-foreground-color: Theme.text;
            accessible-label: root.label;
            edited => { root.edited(self.text); }
        }
    }
}

/// Small uppercase-feel accent label above a field.
export component Label inherits Text {
    color: Theme.accent;
    font-size: Theme.fs-additional;
    letter-spacing: 3px;
}

export component Muted inherits Text {
    color: Theme.muted;
    font-size: Theme.fs-additional;
    letter-spacing: 1.5px;
    overflow: elide;
}

export component Note inherits Text {
    color: Theme.muted;
    font-size: Theme.fs-additional;
    letter-spacing: 1.5px;
    wrap: word-wrap;
}

/// A tag: a small block of its color with dark text.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    background: root.tint;
    border-radius: self.height / 2;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 1px;
        padding-bottom: 1px;
        Text {
            text: root.text;
            color: Theme.ink;
            font-size: Theme.fs-additional;
            letter-spacing: 0.5px;
            vertical-alignment: center;
        }
    }
}

/// Where a carried thing would land: a dashed pill the size of a Chip, with its name.
export component Place inherits Rectangle {
    in property <string> text;
    width: label.preferred-width + 16px;
    height: label.preferred-height + 2px;
    Dashed {
        radius: root.height / 2;
        stroke: Theme.accent;
    }
    label := Text {
        x: 8px;
        y: 1px;
        text: root.text;
        color: Theme.muted;
        font-size: Theme.fs-additional;
        letter-spacing: 0.5px;
    }
}

/// A line from the spot a carried thing was picked up to where it is now, with a ring on that
/// spot. Coordinates are in this element's frame, so give it the whole area a drag can cross.
export component Tether inherits Rectangle {
    in property <length> from-x;
    in property <length> from-y;
    in property <length> to-x;
    in property <length> to-y;
    Path {
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        fit: fill;
        stroke: Theme.accent;
        stroke-width: 1px;
        commands: "M \{root.from-x / 1px} \{root.from-y / 1px} L \{root.to-x / 1px} \{root.to-y / 1px}";
    }
    Rectangle {
        x: root.from-x - 5px;
        y: root.from-y - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        border-width: 1px;
        border-color: Theme.accent;
        background: Theme.bg;
    }
}

/// A tag as a button (picker, filters): dim while off.
export component ChipBtn inherits Squashy {
    in property <string> text;
    in property <color> tint;
    in property <bool> on;
    in property <string> tip;
    /// Reachable with Tab (see KeyFocus).
    in property <bool> tab-stop;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.tip;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    /// Pressed and moved: where the pointer is, in window coordinates; then let go.
    callback dragged(length, length);
    callback dropped();
    property <bool> dragging;
    opacity: root.on ? 1 : 0.35;
    squashed: touch.pressed && !root.dragging;
    Chip {
        text: root.text;
        tint: root.tint;
    }
    touch := TouchArea {
        mouse-cursor: self.pressed && root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.dragging = false;
            } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging {
                root.dropped();
            }
        }
        moved => {
            if root.dragging || Math.abs(self.mouse-x - self.pressed-x) > 4px || Math.abs(self.mouse-y - self.pressed-y) > 4px {
                root.dragging = true;
                root.dragged(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            if !root.dragging {
                root.clicked();
            }
        }
    }
    KeyFocus {
        on: root.tab-stop;
        activated => { root.clicked(); }
    }
    if root.tip != "": Tooltip {
        TipBox {
            text: root.tip;
            from-x: root.absolute-position.x;
        }
    }
}

/// kind: 0 plain, 1 on (accent), 2 warn (danger).
export component Badge inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <string> tip;
    in property <TextHorizontalAlignment> align: left;
    /// Off inside a Films strip, whose walls frame it.
    in property <bool> framed: true;
    property <color> c: root.kind == 1 ? Theme.accent : root.kind == 2 ? Theme.danger : Theme.muted;
    border-radius: self.height / 2;
    border-width: root.framed ? 1px : 0px;
    border-color: root.kind == 0 ? Theme.line : root.c;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 1px;
        padding-bottom: 1px;
        Text {
            text: root.text;
            color: root.c;
            font-size: Theme.fs-additional;
            letter-spacing: 0.5px;
            horizontal-alignment: root.align;
            vertical-alignment: center;
            accessible-description: root.tip;
        }
    }
    if root.tip != "": Tooltip {
        TipBox {
            text: root.tip;
            from-x: root.absolute-position.x;
        }
    }
}

export component Check inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    /// Reachable with Tab (see KeyFocus).
    in property <bool> tab-stop;
    callback toggled(bool);

    function toggle() {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.toggle(); }
    opacity: root.enabled ? 1 : 0.4;
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.accent;
                background: root.checked ? Theme.accent : transparent;
                if root.checked: Text {
                    text: "✓";
                    color: Theme.bg;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.fs-secondary;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
    KeyFocus {
        on: root.tab-stop && root.enabled;
        activated => { root.toggle(); }
    }
}

export component Radio inherits Rectangle {
    in property <bool> checked;
    in property <string> text;
    /// Reachable with Tab (see KeyFocus).
    in property <bool> tab-stop;
    callback clicked();
    accessible-role: radio-button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.accent;
                if root.checked: Rectangle {
                    x: 4px;
                    y: 4px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.accent;
                }
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.fs-secondary;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    KeyFocus {
        on: root.tab-stop;
        activated => { root.clicked(); }
    }
}

/// A labelled value, dragged or clicked along a line. `step` rounds it, so whole numbers use 1.
export component Slider inherits Rectangle {
    in property <string> text;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    /// What shows at the right of the label; empty hides it.
    in property <string> readout: root.value.to-fixed(root.step >= 1 ? 0 : 2);
    /// Reachable with Tab (see KeyFocus); the arrow keys move it a step.
    in property <bool> tab-stop;
    callback changed(float);

    property <float> t: Math.clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);

    function set-value(v: float) {
        let rounded = Math.round(Math.clamp(v, root.minimum, root.maximum) / root.step) * root.step;
        if rounded != root.value {
            root.value = rounded;
            root.changed(rounded);
        }
    }
    function set(x: length) {
        root.set-value(root.minimum + Math.clamp((x - 6px) / (track.width - 12px), 0, 1) * (root.maximum - root.minimum));
    }

    accessible-role: slider;
    accessible-label: root.text;
    accessible-value: root.readout != "" ? root.readout : root.value.to-fixed(2);
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.set-value(root.value + root.step); }
    accessible-action-decrement => { root.set-value(root.value - root.step); }
    accessible-action-set-value(v) => { root.set-value(v.to-float()); }

    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            Muted {
                text: root.text;
                horizontal-stretch: 1;
                accessible-role: none;
            }
            Text {
                text: root.readout;
                color: touch.pressed ? Theme.accent : Theme.text;
                font-size: Theme.fs-additional;
                accessible-role: none;
            }
        }
        // The line is inset by the head's radius, so the head stays inside at both ends.
        track := Rectangle {
            height: 14px;
            Rectangle {
                x: 6px;
                y: parent.height / 2;
                width: parent.width - 12px;
                height: 1px;
                background: Theme.line;
            }
            Rectangle {
                x: 6px;
                y: parent.height / 2;
                width: (parent.width - 12px) * root.t;
                height: 1px;
                background: Theme.accent;
            }
            Rectangle {
                x: (parent.width - 12px) * root.t;
                y: 1px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: touch.has-hover || touch.pressed ? Theme.text : Theme.accent;
            }
            touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                        root.set(self.mouse-x);
                    }
                }
                moved => {
                    if self.pressed {
                        root.set(self.mouse-x);
                    }
                }
            }
        }
    }
    KeyFocus {
        on: root.tab-stop;
        arrows: true;
        stepped(d) => { root.set-value(root.value + d * root.step); }
    }
}

export component HLine inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

export component VLine inherits Rectangle {
    width: 1px;
    background: Theme.line;
}

/// Dialog title bar: ⌜title⌟ over a line.
export component DialogHead inherits Rectangle {
    in property <string> title;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        Bracketed {
            text: root.title;
            alignment: start;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

/// Fades a scrolled area's edges into the ground where there's more to scroll to. Lay it over
/// the Flickable at the same size; it doesn't take clicks.
export component EdgeFade inherits Rectangle {
    in property <bool> above;
    in property <bool> below;
    Rectangle {
        height: 28px;
        background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg.with-alpha(0) 100%);
        opacity: root.above ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
    Rectangle {
        y: root.height - self.height;
        height: 28px;
        background: @linear-gradient(0deg, Theme.bg 0%, Theme.bg.with-alpha(0) 100%);
        opacity: root.below ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
}

/// Empty space as a field of places: a faint dot every 12px. Each row is one Path of a fixed
/// 1920px run of dots, cut to the width, so a big empty area is a few dozen paths.
export component Lattice inherits Rectangle {
    clip: true;
    for r in Math.ceil(root.height / 12px): Path {
        y: r * 12px;
        width: 1920px;
        height: 2px;
        viewbox-width: 1920;
        viewbox-height: 2;
        fit: fill;
        fill: Theme.line;
        commands: "M0 0h1.5v1.5h-1.5zM12 0h1.5v1.5h-1.5zM24 0h1.5v1.5h-1.5zM36 0h1.5v1.5h-1.5zM48 0h1.5v1.5h-1.5zM60 0h1.5v1.5h-1.5zM72 0h1.5v1.5h-1.5zM84 0h1.5v1.5h-1.5zM96 0h1.5v1.5h-1.5zM108 0h1.5v1.5h-1.5zM120 0h1.5v1.5h-1.5zM132 0h1.5v1.5h-1.5zM144 0h1.5v1.5h-1.5zM156 0h1.5v1.5h-1.5zM168 0h1.5v1.5h-1.5zM180 0h1.5v1.5h-1.5zM192 0h1.5v1.5h-1.5zM204 0h1.5v1.5h-1.5zM216 0h1.5v1.5h-1.5zM228 0h1.5v1.5h-1.5zM240 0h1.5v1.5h-1.5zM252 0h1.5v1.5h-1.5zM264 0h1.5v1.5h-1.5zM276 0h1.5v1.5h-1.5zM288 0h1.5v1.5h-1.5zM300 0h1.5v1.5h-1.5zM312 0h1.5v1.5h-1.5zM324 0h1.5v1.5h-1.5zM336 0h1.5v1.5h-1.5zM348 0h1.5v1.5h-1.5zM360 0h1.5v1.5h-1.5zM372 0h1.5v1.5h-1.5zM384 0h1.5v1.5h-1.5zM396 0h1.5v1.5h-1.5zM408 0h1.5v1.5h-1.5zM420 0h1.5v1.5h-1.5zM432 0h1.5v1.5h-1.5zM444 0h1.5v1.5h-1.5zM456 0h1.5v1.5h-1.5zM468 0h1.5v1.5h-1.5zM480 0h1.5v1.5h-1.5zM492 0h1.5v1.5h-1.5zM504 0h1.5v1.5h-1.5zM516 0h1.5v1.5h-1.5zM528 0h1.5v1.5h-1.5zM540 0h1.5v1.5h-1.5zM552 0h1.5v1.5h-1.5zM564 0h1.5v1.5h-1.5zM576 0h1.5v1.5h-1.5zM588 0h1.5v1.5h-1.5zM600 0h1.5v1.5h-1.5zM612 0h1.5v1.5h-1.5zM624 0h1.5v1.5h-1.5zM636 0h1.5v1.5h-1.5zM648 0h1.5v1.5h-1.5zM660 0h1.5v1.5h-1.5zM672 0h1.5v1.5h-1.5zM684 0h1.5v1.5h-1.5zM696 0h1.5v1.5h-1.5zM708 0h1.5v1.5h-1.5zM720 0h1.5v1.5h-1.5zM732 0h1.5v1.5h-1.5zM744 0h1.5v1.5h-1.5zM756 0h1.5v1.5h-1.5zM768 0h1.5v1.5h-1.5zM780 0h1.5v1.5h-1.5zM792 0h1.5v1.5h-1.5zM804 0h1.5v1.5h-1.5zM816 0h1.5v1.5h-1.5zM828 0h1.5v1.5h-1.5zM840 0h1.5v1.5h-1.5zM852 0h1.5v1.5h-1.5zM864 0h1.5v1.5h-1.5zM876 0h1.5v1.5h-1.5zM888 0h1.5v1.5h-1.5zM900 0h1.5v1.5h-1.5zM912 0h1.5v1.5h-1.5zM924 0h1.5v1.5h-1.5zM936 0h1.5v1.5h-1.5zM948 0h1.5v1.5h-1.5zM960 0h1.5v1.5h-1.5zM972 0h1.5v1.5h-1.5zM984 0h1.5v1.5h-1.5zM996 0h1.5v1.5h-1.5zM1008 0h1.5v1.5h-1.5zM1020 0h1.5v1.5h-1.5zM1032 0h1.5v1.5h-1.5zM1044 0h1.5v1.5h-1.5zM1056 0h1.5v1.5h-1.5zM1068 0h1.5v1.5h-1.5zM1080 0h1.5v1.5h-1.5zM1092 0h1.5v1.5h-1.5zM1104 0h1.5v1.5h-1.5zM1116 0h1.5v1.5h-1.5zM1128 0h1.5v1.5h-1.5zM1140 0h1.5v1.5h-1.5zM1152 0h1.5v1.5h-1.5zM1164 0h1.5v1.5h-1.5zM1176 0h1.5v1.5h-1.5zM1188 0h1.5v1.5h-1.5zM1200 0h1.5v1.5h-1.5zM1212 0h1.5v1.5h-1.5zM1224 0h1.5v1.5h-1.5zM1236 0h1.5v1.5h-1.5zM1248 0h1.5v1.5h-1.5zM1260 0h1.5v1.5h-1.5zM1272 0h1.5v1.5h-1.5zM1284 0h1.5v1.5h-1.5zM1296 0h1.5v1.5h-1.5zM1308 0h1.5v1.5h-1.5zM1320 0h1.5v1.5h-1.5zM1332 0h1.5v1.5h-1.5zM1344 0h1.5v1.5h-1.5zM1356 0h1.5v1.5h-1.5zM1368 0h1.5v1.5h-1.5zM1380 0h1.5v1.5h-1.5zM1392 0h1.5v1.5h-1.5zM1404 0h1.5v1.5h-1.5zM1416 0h1.5v1.5h-1.5zM1428 0h1.5v1.5h-1.5zM1440 0h1.5v1.5h-1.5zM1452 0h1.5v1.5h-1.5zM1464 0h1.5v1.5h-1.5zM1476 0h1.5v1.5h-1.5zM1488 0h1.5v1.5h-1.5zM1500 0h1.5v1.5h-1.5zM1512 0h1.5v1.5h-1.5zM1524 0h1.5v1.5h-1.5zM1536 0h1.5v1.5h-1.5zM1548 0h1.5v1.5h-1.5zM1560 0h1.5v1.5h-1.5zM1572 0h1.5v1.5h-1.5zM1584 0h1.5v1.5h-1.5zM1596 0h1.5v1.5h-1.5zM1608 0h1.5v1.5h-1.5zM1620 0h1.5v1.5h-1.5zM1632 0h1.5v1.5h-1.5zM1644 0h1.5v1.5h-1.5zM1656 0h1.5v1.5h-1.5zM1668 0h1.5v1.5h-1.5zM1680 0h1.5v1.5h-1.5zM1692 0h1.5v1.5h-1.5zM1704 0h1.5v1.5h-1.5zM1716 0h1.5v1.5h-1.5zM1728 0h1.5v1.5h-1.5zM1740 0h1.5v1.5h-1.5zM1752 0h1.5v1.5h-1.5zM1764 0h1.5v1.5h-1.5zM1776 0h1.5v1.5h-1.5zM1788 0h1.5v1.5h-1.5zM1800 0h1.5v1.5h-1.5zM1812 0h1.5v1.5h-1.5zM1824 0h1.5v1.5h-1.5zM1836 0h1.5v1.5h-1.5zM1848 0h1.5v1.5h-1.5zM1860 0h1.5v1.5h-1.5zM1872 0h1.5v1.5h-1.5zM1884 0h1.5v1.5h-1.5zM1896 0h1.5v1.5h-1.5zM1908 0h1.5v1.5h-1.5zM1920 0h1.5v1.5h-1.5z";
    }
}

/// Something is being done: a ring of dots with one lit, stepping on a timer rather than redrawing
/// every frame. It sits in a layout's middle on its own.
export component Steps inherits VerticalLayout {
    in property <bool> running: true;
    property <int> at;
    alignment: center;
    Rectangle {
        width: 18px;
        height: 18px;
        Timer {
            interval: 150ms;
            running: root.running;
            triggered => { root.at = Math.mod(root.at + 1, 8); }
        }
        for i in 8: Rectangle {
            x: 7.5px + 7px * Math.cos(i * 45deg - 90deg);
            y: 7.5px + 7px * Math.sin(i * 45deg - 90deg);
            width: 3px;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.accent.with-alpha(i == root.at ? 1 : 0.3);
        }
    }
}

/// Dialog button row, right-aligned under a line.
export component DialogFoot inherits Rectangle {
    Rectangle {
        y: 0px;
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        // Beads: the buttons after the first set `bead`.
        spacing: Theme.bead-gap;
        alignment: end;
        @children
    }
}

/// Album color swatch; the picker one shows the hue wheel itself.
export component Swatch inherits Rectangle {
    in property <color> fill;
    in property <bool> on;
    in property <string> glyph;
    in property <image> wheel;
    in property <bool> is-wheel;
    in property <string> tip;
    in property <color> frame: transparent;
    /// Reachable with Tab (see KeyFocus).
    in property <bool> tab-stop;
    callback clicked();
    accessible-role: button;
    accessible-label: root.tip != "" ? root.tip : root.glyph;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 1px;
    border-color: root.on ? Theme.text : touch.has-hover ? Theme.muted : root.frame;
    Rectangle {
        x: 3px;
        y: 3px;
        width: parent.width - 6px;
        height: parent.height - 6px;
        border-radius: self.width / 2;
        background: root.fill;
    }
    if root.is-wheel: Image {
        x: 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        source: root.wheel;
        accessible-role: none;
    }
    if root.glyph != "": Text {
        text: root.glyph;
        color: Theme.text;
        font-size: Theme.fs-additional;
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    KeyFocus {
        on: root.tab-stop;
        activated => { root.clicked(); }
    }
    if root.tip != "": Tooltip {
        TipBox {
            text: root.tip;
            from-x: root.absolute-position.x;
        }
    }
}

/// Hue around, saturation outward. Reports where it was pressed, from -1 to 1 on each axis.
export component ColorWheel inherits Rectangle {
    in property <image> wheel;
    callback picked(float, float);
    width: 200px;
    height: 200px;
    // Pointer only: keyboards and screen readers need another way in, like Albumka's hex field.
    Image {
        width: 100%;
        height: 100%;
        source: root.wheel;
        accessible-role: none;
    }
    TouchArea {
        mouse-cursor: crosshair;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.picked(self.mouse-x / self.width * 2 - 1, self.mouse-y / self.height * 2 - 1);
            }
        }
        moved => {
            if self.pressed {
                root.picked(self.mouse-x / self.width * 2 - 1, self.mouse-y / self.height * 2 - 1);
            }
        }
    }
}

/// A point and size as fractions of a box, e.g. the bars of a small graph.
export struct Dot {
    x: float,
    y: float,
    d: float,
    a: float,
}

/// A ring mark from `kitka::sigil`, as Path commands in a 100 x 100 box.
export struct Sigil {
    rings: string,
    hits: string,
    rests: string,
}

/// A Sigil centred in the box, as big as its shorter side: a placeholder cover, say. Three paths
/// however many names it has.
export component RingCover inherits Rectangle {
    in property <Sigil> sigil;
    in property <color> tint;
    property <length> s: Math.min(self.width, self.height);
    Path {
        x: (root.width - root.s) / 2;
        y: (root.height - root.s) / 2;
        width: root.s;
        height: root.s;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        stroke: root.tint.with-alpha(0.15);
        stroke-width: 1px;
        commands: root.sigil.rings;
    }
    Path {
        x: (root.width - root.s) / 2;
        y: (root.height - root.s) / 2;
        width: root.s;
        height: root.s;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        fill: root.tint.with-alpha(0.3);
        commands: root.sigil.rests;
    }
    Path {
        x: (root.width - root.s) / 2;
        y: (root.height - root.s) / 2;
        width: root.s;
        height: root.s;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: fill;
        fill: root.tint;
        commands: root.sigil.hits;
    }
}
